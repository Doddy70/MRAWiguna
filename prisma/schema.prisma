// Prisma schema for Bengkel Assistant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  phone     String
  plate     String
  service   String
  date      String
  time      String
  complaint String
  status    String
  createdAt DateTime @default(now())
}
